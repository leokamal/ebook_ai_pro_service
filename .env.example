# E-Book AI Pro - placeholders only. Never commit real values.
ENVIRONMENT=development
SUPABASE_URL=https://<project-ref>.supabase.co
# publishable/anon key: used by this API to forward the USER's JWT to PostgREST (RLS applies)
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# service_role key: server only, bypasses RLS, never give it to Flutter
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# default: $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
# optional: only for projects that still sign JWTs with a shared HS256 secret
SUPABASE_JWT_SECRET=
# migrations / ops scripts / integration tests only; not used on the request path
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=user-documents
GEMINI_API_KEY=<gemini-key>
GEMINI_MODEL=gemini-3.5-flash
# tried when GEMINI_MODEL stays unavailable (503 high demand); empty = off
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Embeddings: gemini (API, default) | huggingface (local model; needs requirements-huggingface.txt).
# Changing the provider or model needs POST /api/v1/admin/reindex.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
# used only with EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=ebook_ai_pro_documents
# Ingestion / worker (defaults shown)
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=1000
EMBED_BATCH=32
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
JOB_LEASE_SECONDS=300
# RAG / LLM (defaults shown)
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
HISTORY_MESSAGES=6
RAG_CANDIDATES=20
RAG_CONTEXT_CHUNKS=6
RAG_MAX_PER_DOC=3
RAG_CONDENSE_QUESTION=true
# RAG_MIN_SCORE=   (unset = no cut-off; tune after testing the multilingual model)
CHAT_RATE_PER_MINUTE=20
SEARCH_RATE_PER_MINUTE=60
LLM_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_CONCURRENT_STREAMS=2
LLM_STREAM_DEADLINE_SECONDS=120
# Sign-in providers accepted by the API (empty = any; local development only)
AUTH_ALLOWED_PROVIDERS=google,facebook
ORPHAN_MAX_AGE_HOURS=24
# finished processing jobs are removed after this many days
JOB_RETENTION_DAYS=30
